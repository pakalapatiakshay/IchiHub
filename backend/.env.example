# Copy this file to .env and replace the development values before deployment.
PORT=4000
HOST=127.0.0.1
DATA_FILE=./data/ichihub.json
TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Set these once to securely provision the first super administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_ADMIN_NAME=IchiHub Administrator
